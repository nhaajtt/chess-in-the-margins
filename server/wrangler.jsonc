{
  // the rooms service for Chess in the margins
  "name": "chess-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://chess.nhaajt.com,http://localhost:5190"
  },
  "observability": { "enabled": true }
}

{
  // the rooms service for Chess in the margins
  "name": "chess-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  // v1 is already deployed, so the lobby gets its own new step
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://chess.nhaajt.com"
  },
  // new rooms and match requests per visitor address: 10 a minute
  "ratelimits": [{ "name": "OPEN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}

{
  "name": "chess-in-the-margins",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/r/*"
    ]
  },
  "routes": [{ "pattern": "chess.nhaajt.com", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "main": "worker.js"
}
